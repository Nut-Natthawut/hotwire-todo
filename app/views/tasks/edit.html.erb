<% content_for :title, "Edit task" %>

<div class="rounded-2xl border bg-white p-6">
  <h1 class="mb-4 text-xl font-semibold">Edit task</h1>
  <%# Same frame id as the row (task_1): the form replaces just that row. %>
  <%= turbo_frame_tag dom_id(@task) do %>
    <%= render partial: "tasks/form", locals: { task: @task } %>
  <% end %>
</div>
